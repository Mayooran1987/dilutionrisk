#' Truncated Poisson Random Number Generation
#'
#' Generates random deviates from a truncated Poisson distribution.
#'
#' @param n Number of observations.
#' @param lambda Expected count parameter.
#' @param a Lower truncation point.
#' @param b Upper truncation point.
#'
#' @return A vector of random numbers from the truncated Poisson distribution.
#' @export
rtpois <- function(n, lambda, a, b) {
  # Input validation
  if (!is.numeric(n) || length(n) == 0) {
    stop("'n' must be a positive integer", call. = FALSE)
  }

  if (length(n) > 1) {
    n <- length(n)
  } else {
    if (n < 1 || n != round(n)) {
      stop("'n' must be a positive integer", call. = FALSE)
    }
  }

  if (!is.numeric(lambda) || length(lambda) != 1 || lambda <= 0) {
    stop("'lambda' must be a positive numeric scalar", call. = FALSE)
  }
  if (!is.numeric(a) || length(a) != 1 || a < 0) {
    stop("'a' must be a non-negative numeric scalar", call. = FALSE)
  }
  if (!is.numeric(b) || length(b) != 1 || b <= a) {
    stop("'b' must be a numeric scalar greater than 'a'", call. = FALSE)
  }

  # Check if lambda is within bounds
  if (lambda < a || lambda > b) {
    # Use rejection sampling
    result <- numeric(n)
    for (i in seq_len(n)) {
      x <- stats::rpois(1, lambda)
      iter <- 0
      while ((x < a || x > b) && iter < 1000000) {
        iter <- iter + 1
        x <- stats::rpois(1, lambda)
      }
      if (iter >= 1000000) {
        warning("Rejection sampling reached maximum iterations", call. = FALSE)
        result[i] <- NA
      } else {
        result[i] <- x
      }
    }
    return(result)
  } else {
    # Direct generation with truncation check
    result <- numeric(n)
    for (i in seq_len(n)) {
      x <- stats::rpois(1, lambda)
      while ((x < a || x > b) && iter < 1000000) {
        x <- stats::rpois(1, lambda)
      }
      result[i] <- x
    }
    return(result)
  }
}

#' @rdname rtrunpoilog
#' @export
rtrunpoilog <- function(n, mu, sd, a, b) {
  # Input validation
  if (!is.numeric(n) || length(n) == 0) {
    stop("'n' must be a positive integer", call. = FALSE)
  }

  if (length(n) > 1) {
    n <- length(n)
  } else {
    if (n < 1 || n != round(n)) {
      stop("'n' must be a positive integer", call. = FALSE)
    }
  }

  if (!is.numeric(mu) || length(mu) != 1) {
    stop("'mu' must be a numeric scalar", call. = FALSE)
  }
  if (!is.numeric(sd) || length(sd) != 1 || sd <= 0) {
    stop("'sd' must be a positive numeric scalar", call. = FALSE)
  }
  if (!is.numeric(a) || length(a) != 1 || a < 0) {
    stop("'a' must be a non-negative numeric scalar", call. = FALSE)
  }
  if (!is.numeric(b) || length(b) != 1 || b <= a) {
    stop("'b' must be a numeric scalar greater than 'a'", call. = FALSE)
  }

  # Check if mean is within bounds
  if (mu > log(b, exp(1)) || mu < log(a, exp(1))) {
    stop("The truncated Poisson lognormal (TPLN) random variable must be bounded by a and b,\n",
         "which means that mu must be between log(a) and log(b).\n",
         sprintf("Current mu = %.4f, bounds: [%.4f, %.4f]",
                 mu, log(a, exp(1)), log(b, exp(1))),
         call. = FALSE)
  }

  # Generate lognormal random variables
  lambda <- stats::rlnorm(n = n, meanlog = mu, sdlog = sd)

  # Generate truncated Poisson random variables
  result <- numeric(n)
  for (i in seq_along(lambda)) {
    x <- stats::rpois(1, lambda[i])
    iter <- 0
    while ((x < a || x > b) && iter < 1000000) {
      iter <- iter + 1
      # Regenerate lambda if needed
      if (iter %% 100 == 0) {
        lambda[i] <- stats::rlnorm(1, meanlog = mu, sdlog = sd)
      }
      x <- stats::rpois(1, lambda[i])
    }
    if (iter >= 1000000) {
      warning("Rejection sampling reached maximum iterations", call. = FALSE)
      result[i] <- NA
    } else {
      result[i] <- x
    }
  }

  return(result)
}
