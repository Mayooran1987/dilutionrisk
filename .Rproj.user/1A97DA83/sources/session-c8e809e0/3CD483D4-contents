# Clean everything
devtools::clean_dll()

# Remove any remaining compiled files
unlink("src", recursive = TRUE, force = TRUE)
unlink("R/RcppExports.R", force = TRUE)
unlink("inst/libs", recursive = TRUE, force = TRUE)
unlink("libs", recursive = TRUE, force = TRUE)
unlink("*.o", force = TRUE)
unlink("*.dll", force = TRUE)
unlink("*.so", force = TRUE)

# Remove the package from library if installed
remove.packages("dilutionrisk")

# Document and install
devtools::document(roclets = c('rd', 'collate', 'namespace', 'vignette'))
devtools::install()
# Load the package
library(dilutionrisk)

